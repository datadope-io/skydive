"""
Return information about the creation/update of an Skydive node
"""
type net_NodePayload {
  """
  Internal ID for the node in Skydive.
  """
  ID: String!

  """
  Return true if a new node has been created
  """
  NodeCreated: Boolean!

  """
  Return true if a node with this name already exists and metadata values
  have been updated.
  """
  NodeUpdated: Boolean!
}

"""
Return information about the creation/update of an Skydive edge
"""
type net_EdgePayload {
  """
  Internal ID for the edge in Skydive.
  """
  ID: String!

  """
  Return true if a new edge has been created
  """
  EdgeCreated: Boolean!

  """
  Return true if a edge with this name already exists and metadata values
  have been updated.
  """
  EdgeUpdated: Boolean!
}

"""
Use a Gremlin query or a Skydive ID to select a node in the Skydive graph.
"""
input net_Selector {
  """
  Select device by using its Skydive internal ID
  """
  ID: String
  """
  Skydive Gremlin query to select the device
  """
  GremlinQuery: String
}

"""
Values to create a new network device.
"""
input net_DeviceInput {
  """
  Identifier used by routers.
  The value should be taken from this fields in the configurations files:
    Huawei: router id
    Cisco: router-id
    Juniper: routing-options.router-id
    Nokia: configure.router Base.interface "system".address
  """
  DeviceID: String

  """
  Device name. Used as the primary key.
  """
  Name: String!

  """
  Device type: router, switch, etc.
  """
  Type: net_DeviceType

  """
  Vendor of the device: Cisco, Juniper, etc.
  """
  Vendor: String

  """
  Device model, eg.: CBS250-8P-E-2G
  """
  Model: String

  """
  For Type=TransmissionNode, we can specify the name of the building
  where the device is located.
  """
  BuildingName: String

  """
  Optional field to establish the creation time of the skydive elements. If
  not set, defaults to the current time.
  If the node already exists and this value is different from the existing one, it will
  produce an error.
  Format: 2021-01-01T00:00:00Z
  """
  CreatedAt: Time

  """
  Ubicación del dispositivo. Código del edificio.
  """
  Building: String
}

"""
Define the kind of network device
"""
enum net_DeviceType {
  Router
  Switch
  TransmissionNode
}

"""
Define the kind of link between interfaces
"""
enum net_LinkType {
  """Link type for xDP connections"""
  Connect
  RadioLink
}

"""
Return value when creating a new network device.
"""
type net_DevicePayload {
  """
  Information about the device
  """
  Device: net_NodePayload!
}

"""
Values to add a physical interface to a network device.
Aggregation interface is created if it does not exists.
"""
input net_AddInterfaceInput {
  """
  Select which network device owns this interface
  """
  DeviceSelector: net_Selector!
  """
  Data of the interface to be added
  """
  Interface: net_InterfaceInput!
  """
  If this interface is aggregated, name of the aggregation
  """
  Aggregation: String
  """
  Optional field to establish the creation time of the skydive elements. If
  not set, defaults to the current time.
  Format: 2021-01-01T00:00:00Z
  """
  CreatedAt: Time
}

"""
Values to delete an interface from a network device.
"""
input net_DelInterfaceInput {
  """
  Select which interface to be deleted
  """
  InterfaceSelector: net_Selector!
}

"""
Return value when creating a new physical interface.
"""
type net_InterfacePayload {
  """
  Information about the physical interface
  """
  Interface: net_NodePayload!
  """
  Information about the aggregation interface.
  Defined only if the input has an aggregation interface defined.
  """
  Aggregation: net_NodePayload
}

"""
Values to add a physical interface to a network device
"""
input net_AddAggregationInput {
  """
  Select which network device owns this aggregation
  """
  DeviceSelector: net_Selector!
  """
  Data of the aggregation to be added
  """
  Aggregation: net_InterfaceInput!
  """
  Optional field to establish the creation time of the skydive elements. If
  not set, defaults to the current time.
  Format: 2021-01-01T00:00:00Z
  """
  CreatedAt: Time
}

"""
Return value when creating a new aggregation interface.
"""
type net_AggregationPayload {
  """
  Information about the aggregation interface.
  """
  Aggregation: net_NodePayload!
}

"""
Data defining a network interface
"""
input net_InterfaceInput {
  """
  Name of the interface
  """
  Name: String!
  """
  Interface description
  """
  Description: [net_KeyValue!]
  """
  Ethernet data of the interface
  """
  Ethernet: net_EthernetInput
  """
  IP addresses of the interface, IPv4 or IPv6
  IP data of the interface.
  IPv4 format: 192.0.2.0/24
  IPv6 format: 2002:db8::/32
  """
  IP: [String!]
  """
  Pseudowire of the interface.
  """
  PseudoWires: [net_PseudowireInput!]
}

"""
Pseudowire data of a network interface.
There are two types of pseudowires:
    - normal: should define ID and Neighbor
    - EVPN-VPWS: should define LocalVPWS and RemoteVPWS
"""
input net_PseudowireInput {
  """
  ID of the pseudowire
  """
  ID: String
  """
  IP of the neighbor connected to this pseudowire
  """
  Neighbor: String
  """
  Local VPWS ID for EVPN-VPWS pseudowires
  """
  LocalVPWS: String
  """
  Remote VPWS ID for EVPN-VPWS pseudowires
  """
  RemoteVPWS: String
  """
  For Huawei PW, set to "secondary" if this is the secondary pseudowire
  For Nokia, set to "primary" if this is the primary pseudowire.
  """
  Status: String
}

"""
Ethernet data related to an interface
"""
input net_EthernetInput {
  """
  VLAN data of the interface
  """
  VLAN: net_VLANInput
}

"""
VLAN data for an interface
"""
input net_VLANInput {
  """
  If the interface is in access mode, this input should be defined
  """
  Access: net_VLANAccessInput
  """
  If the interface is in trunk mode, this input should be defined
  """
  Trunk: net_VLANTrunkInput
}

"""
VLAN data for interfaces configured in access mode
"""
input net_VLANAccessInput {
  """
  VLAN id
  """
  VID: Int!
}

"""
VLAN data for interfaces configured in trunk mode
"""
input net_VLANTrunkInput {
  """
  List of VLAN IDs to be accepted by the trunk port
  """
  AcceptedVIDs: [Int!]!
  """
  Native VLAN ID.
  VLAN ID used for untagged packets
  """
  NativeVLANVID: Int
}

"""
Values to add a logical interface backed by a physical or aggregation interface
"""
input net_AddLogicalInterfaceInput {
  """
  Select which interface owns this logical interface
  """
  InterfaceSelector: net_Selector!
  """
  Data of the logical interface to be added
  """
  Interface: net_InterfaceInput!
  """
  Optional field to establish the creation time of the skydive elements. If
  not set, defaults to the current time.
  Format: 2021-01-01T00:00:00Z
  """
  CreatedAt: Time
}

"""
Return value when creating a new logical interface interface.
"""
type net_LogicalInterfacePayload {
  """
  Information about the logical interface.
  """
  LogicalInterface: net_NodePayload!
}


"""
Values to create a LLDP link between nodes.
"""
input net_AddIf2IfLinkInput {
  """
  Source interface.
  """
  SrcInterface: net_Selector!

  """
  Destination interface.
  """
  DstInterface: net_Selector!

  """
  Link name
  """
  Name: String

  """
  State, if we want to define the link state, eg.: up, down, etc
  """
  State: String

  """
  Link type. If not defiend is "Connect" (xDP)
  """
  Type: net_LinkType

  """
  Optional field to establish the creation time of the skydive elements. If
  not set, defaults to the current time.
  Format: 2021-01-01T00:00:00Z
  """
  CreatedAt: Time
}

"""
Values to delete a LLDP link between nodes.
"""
input net_DelIf2IfLinkInput {
  """
  Source interface.
  """
  SrcInterface: net_Selector!

  """
  Destination interface.
  """
  DstInterface: net_Selector!

  """
  Link type. If not defiend is "Connect" (xDP)
  """
  Type: net_LinkType
}

"""
Return value when creating or deleting a LLDP link between interfaces.
"""
type net_If2IfLinkPayload {
  """
  Internal ID for the edge in Skydive.
  """
  InterfaceLinks: [net_EdgePayload!]!
}

"""
Values to define a location in a map
"""
input net_LocationInput {
  """
  Latitude in decimal degrees.
  """
  Lat: Float!
  """
  Longitude in decimal degrees.
  """
  Lng: Float!
}

"""
Values to create a new region (comunidad autónoma)
"""
input net_RegionInput {
  """
  Name of the region
  """
  Name: String!
  """
  Reference location for the region
  """
  Location: net_LocationInput!
  """
  Optional field to establish the creation time of the skydive elements. If
  not set, defaults to the current time.
  Format: 2021-01-01T00:00:00Z
  """
  CreatedAt: Time
}

"""
Return value when creating a new region.
"""
type net_RegionPayload {
  """
  SKydive ID of the node created
  """
  ID: String!

  """
  Return true if a new node has been created
  """
  NodeCreated: Boolean!

  """
  Return true if a node with this name already exists and metadata values
  have been updated.
  """
  NodeUpdated: Boolean!
}

"""
Values to create a new province, linked to a region (that should already exist)
"""
input net_ProvinceInput {
  """
  Name of the region for this province
  """
  Region: String!
  """
  Name of the province
  """
  Name: String!
  """
  Reference location for the province
  """
  Location: net_LocationInput!
  """
  Optional field to establish the creation time of the skydive elements. If
  not set, defaults to the current time.
  Format: 2021-01-01T00:00:00Z
  """
  CreatedAt: Time
}

"""
Return value when creating a new province.
"""
type net_ProvincePayload {
  """
  SKydive ID of the node created
  """
  ID: String!

  """
  Return true if a new node has been created
  """
  NodeCreated: Boolean!

  """
  Return true if a node with this name already exists and metadata values
  have been updated.
  """
  NodeUpdated: Boolean!
}


"""
Values to create a new building, linked to a province (that should already exist)
"""
input net_BuildingInput {
  """
  Name of the province for this building
  """
  Province: String!
  """
  Name of the building
  """
  Name: String!
  """
  This could be used to identify buildings used for different purposes.
  Each of this classes would be added as key values to the building metadata, so they could be used to filter the building.
  If the building already exists, the new key value will be added to the existing metadata.
  """
  Class: String
  """
  Location for the building
  """
  Location: net_LocationInput!
  """
  Optional field to establish the creation time of the skydive elements. If
  not set, defaults to the current time.
  Format: 2021-01-01T00:00:00Z
  """
  CreatedAt: Time
}

"""
Return value when creating a new building.
"""
type net_BuildingPayload {
  """
  Information about the building
  """
  Building: net_NodePayload!
}

"""
Simple input to add any extra data in a key-value fashion
"""
input net_KeyValue {
  Key: String!
  Value: String!
}

