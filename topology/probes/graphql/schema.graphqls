type Mutation {
  """
  Create, or update, a region (Comunidad Autónoma).
  If the node already exists, new values will override existing values.
  """
  net_AddRegion(input: net_RegionInput!): net_RegionPayload!

  """
  Create, or update, a province.
  If the node already exists, new values will override existing values.
  """
  net_AddProvince(input: net_ProvinceInput!): net_ProvincePayload!

  """
  Create, or update, a building.
  If the node already exists, new values will override existing values.
  """
  net_AddBuilding(input: net_BuildingInput!): net_BuildingPayload!

  """
  Create, or update, a network element.
  If the node already exists, new values will override existing values.
  Not defining device type, model or vendor will delete that value.
  Function will return error if there is a problem creating the device.
  """
  net_AddDevice(input: net_DeviceInput!): net_DevicePayload!

  """
  Create, or update, an interface owned by a device.
  Device could be selected using its ID or a Gremlin query.
  A node is created to represent the interface and linked to the device node.
  """
  net_AddInterface(input: net_AddInterfaceInput!): net_InterfacePayload!

  """
  Delete an interface. It could be an interface of any type.
  """
  net_DelInterface(input: net_DelInterfaceInput!): net_InterfacePayload!

  """
  Create, or update, an aggregation interface owned by a device.
  Device could be selected using its ID or a Gremlin query.
  A node is created to represent the aggregation and linked to the device node.
  """
  net_AddAggregation(input: net_AddAggregationInput!): net_AggregationPayload!

  """
  Create, or update, a logical interface, which uses a  physical interface or aggregation.
  Interface/aggregation could be selected using its ID or a Gremlin query.
  A node is created to represent the logical interface and linked to the interface/agg node.
  """
  net_AddLogicalInterface(input: net_AddLogicalInterfaceInput!): net_LogicalInterfacePayload!

  """
  Add an edge between two physical interfaces
  """
  net_AddIf2IfLink(input: net_AddIf2IfLinkInput!): net_If2IfLinkPayload!

  """
  Delete an LLDP edge between two physical interfaces
  """
  net_DelIf2IfLink(input: net_DelIf2IfLinkInput!): net_If2IfLinkPayload!

  """
  Add event to node.
  """
  event_Add(input: event_AddInput!): event_AddPayload!

  """
  Add events to nodes.
  Will only generate error if there is only one event and fails.
  Otherwise, will output the errors in the response.
  """
  event_AddMultiple(input: [event_AddInput!]!): event_AddMultiplePayload!

  """
  Remove event from node.
  """
  event_Close(input: event_CloseInput!): event_ClosePayload!
}

type Query {
  version: String!
}

scalar Time
